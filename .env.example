# ─────────────────────────────────────────────────────────────
# Core (required)
# ─────────────────────────────────────────────────────────────
# Postgres connection string.
# Local dev: a Postgres running on your machine.
# Railway: this is provided automatically by the Railway Postgres plugin.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Password for the /admin panel. Use a strong one in production.
ADMIN_PASSWORD="change-me-to-something-strong"

# ─────────────────────────────────────────────────────────────
# Conversion tracking (optional) — leave blank to disable.
# Each pixel only loads when its ID is set.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""            # Google Analytics 4, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""    # Meta (Facebook/Instagram) Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""  # TikTok Pixel ID

# ─────────────────────────────────────────────────────────────
# Customer notifications (optional) — leave blank to just log.
# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API (auto-acknowledge requests + send quotes)
WHATSAPP_TOKEN=""               # permanent access token
WHATSAPP_PHONE_ID=""            # WhatsApp Business phone-number ID

# Email via Resend (used when the customer prefers email)
RESEND_API_KEY=""               # re_xxx
RESEND_FROM=""                  # e.g. Sparezy <noreply@sparezy.store>
