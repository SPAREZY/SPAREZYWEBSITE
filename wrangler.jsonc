{
	"name": "sparezy",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-09-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sparezy",
			"database_id": "a55873ab-c61d-4361-bdff-0c0c9cd5e578",
			"migrations_dir": "migrations"
		}
	]
	// "routes": [
	//   { "pattern": "sparezy.store", "custom_domain": true },
	//   { "pattern": "www.sparezy.store", "custom_domain": true }
	// ]
}